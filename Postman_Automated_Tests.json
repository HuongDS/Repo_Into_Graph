			"value": "https://localhost:7083",
			"type": "string"
		},
		{
			"key": "businessId",
			"value": "YOUR_BUSINESS_ID_HERE",
			"type": "string"
		},
		{
			"key": "generateResponse",
			"value": "{}",
			"type": "string"
		}
	]
