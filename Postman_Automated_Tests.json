							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{{generateResponse}}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/WorkflowAssessment/assess-accuracy",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"WorkflowAssessment",
						"assess-accuracy"
					]
				}
			}
		},
		{
			"name": "4. Assess Difficulty",
