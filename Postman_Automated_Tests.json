{
	"info": {
		"name": "Repo Into Graph - A/B Testing Automation",
		"description": "Bộ test so sánh 2 phương pháp sinh câu hỏi (Code thô vs Đồ thị CFG).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Phương pháp Cũ (Raw Code)",
			"item": [
				{
					"name": "1. Generate Questions (Traditional)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"if(jsonData && jsonData.businessId) {",
									"    pm.collectionVariables.set(\"generateResponse\", JSON.stringify(jsonData));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"businessId\": \"{{businessId}}\",\n  \"numberOfQuestions\": 5,\n  \"difficulty\": \"Medium\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/QuestionGenerator/generate-traditional",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"QuestionGenerator",
								"generate-traditional"
							]
						}
					}
				},
